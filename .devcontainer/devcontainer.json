{
  "name": "skill-cliff-abm",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "Report interattivo",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "James-Yu.latex-workshop"
      ]
    },
    "codespaces": {
      "openFiles": [
        "README.md",
        "notebooks/esplora_modello.ipynb"
      ]
    }
  },
  "hostRequirements": {
    "cpus": 2
  }
}
