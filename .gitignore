__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
build/
dist/

# Output delle simulazioni: si versionano solo gli esempi
outputs/*
!outputs/examples/
!outputs/.gitkeep
_site/
site/vendor/

# LaTeX: il PDF si genera (make paper, oppure il workflow Pages)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.spl
paper/*.synctex.gz
paper/main.pdf
node_modules/

# Traduzioni italiane: si versionano .tex, figure e bibliografia; i PDF vanno in site/
paper/it/*.aux
paper/it/*.bbl
paper/it/*.blg
paper/it/*.fdb_latexmk
paper/it/*.fls
paper/it/*.log
paper/it/*.out
paper/it/*.spl
paper/it/*.pdf
